# ==============================================================================
# INNOVATION+ / CREATIVE STREAM ENVIRONMENT VARIABLES & SECRETS TEMPLATE
# ==============================================================================
# NEVER commit your actual .env file or real secrets to GitHub/Git.
# Copy this file to .env locally or set these in GitHub Secrets / Cloud Run.

# 1. GOOGLE GEMINI AI API (Required for AI Bulk Tags & Recommendations)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# Set in AI Studio Secrets panel or GitHub Secrets as GEMINI_API_KEY
GEMINI_API_KEY=

# 2. APPLICATION HOST URL
# Host URL of the deployed application (e.g. https://your-domain.com or Cloud Run URL)
APP_URL=http://localhost:3000

# 3. CLOUD SQL / POSTGRES DATABASE CREDENTIALS (If using PostgreSQL)
# Store sensitive passwords in GitHub Secrets or GCP Secret Manager
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

