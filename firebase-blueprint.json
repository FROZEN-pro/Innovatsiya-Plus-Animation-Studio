{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "photoURL": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ]
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "banned",
            "trial"
          ]
        },
        "subscriptionTier": {
          "type": "string",
          "enum": [
            "free",
            "pro",
            "vip"
          ]
        },
        "isBanned": {
          "type": "boolean"
        },
        "telegramUsername": {
          "type": "string",
          "maxLength": 100
        },
        "biometricEnabled": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "number"
        },
        "lastLogin": {
          "type": "number"
        },
        "lastLoginAt": {
          "type": "number"
        },
        "loginCount": {
          "type": "number"
        },
        "totalWatchDurationSeconds": {
          "type": "number"
        },
        "totalWatchTimeMinutes": {
          "type": "number"
        },
        "lastActiveAt": {
          "type": "number"
        },
        "recentLoginDevice": {
          "type": "string",
          "maxLength": 100
        },
        "recentLoginMethod": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "uid",
        "role",
        "subscriptionStatus"
      ]
    },
    "Video": {
      "title": "Video",
      "description": "Video metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 50
        },
        "views": {
          "type": "number"
        },
        "likes": {
          "type": "number"
        },
        "duration": {
          "type": "string",
          "maxLength": 20
        },
        "isHd": {
          "type": "boolean"
        },
        "isEncrypted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        },
        "author": {
          "type": "string",
          "maxLength": 100
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 30
          }
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "videoUrl",
        "thumbnailUrl",
        "category",
        "views"
      ]
    },
    "WatchHistory": {
      "title": "WatchHistory",
      "description": "User watch history record",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "maxLength": 128
        },
        "lastWatchedAt": {
          "type": "number"
        },
        "progressSeconds": {
          "type": "number"
        },
        "watchDurationSeconds": {
          "type": "number"
        },
        "completed": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "thumbnailUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "playCount": {
          "type": "number"
        }
      },
      "required": [
        "videoId",
        "lastWatchedAt"
      ]
    },
    "LoginLog": {
      "title": "LoginLog",
      "description": "User authentication and login audit record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "timestamp": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "maxLength": 50
        },
        "device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "userAgent": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "ip": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "userId",
        "timestamp",
        "method"
      ]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a video",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userDisplayName": {
          "type": "string",
          "maxLength": 100
        },
        "userPhotoURL": {
          "type": "string",
          "maxLength": 500
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "videoId",
        "userId",
        "text",
        "createdAt"
      ]
    },
    "UserLike": {
      "title": "UserLike",
      "description": "User like for a video",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "videoId",
        "createdAt"
      ]
    },
    "VideoStats": {
      "title": "VideoStats",
      "description": "Video statistics like total likes",
      "type": "object",
      "properties": {
        "likes": {
          "type": "number"
        }
      },
      "required": [
        "likes"
      ]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User bookmarked or starred favorite video reference for quick access",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "thumbnailUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "videoId",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time system or video release notification",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "new_video",
            "announcement",
            "system"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "videoId": {
          "type": "string",
          "maxLength": 128
        },
        "videoTitle": {
          "type": "string",
          "maxLength": 200
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 50
        },
        "author": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "message",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Real-time video release and broadcast notifications"
    },
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles"
    },
    "videos/{videoId}": {
      "schema": {
        "$ref": "#/entities/Video"
      },
      "description": "Video metadata available for all authenticated users"
    },
    "users/{userId}/watchHistory/{videoId}": {
      "schema": {
        "$ref": "#/entities/WatchHistory"
      },
      "description": "Watch history for a user"
    },
    "users/{userId}/loginLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/LoginLog"
      },
      "description": "User login audit and timestamp trail"
    },
    "comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/Comment"
      },
      "description": "Video comments"
    },
    "users/{userId}/likes/{videoId}": {
      "schema": {
        "$ref": "#/entities/UserLike"
      },
      "description": "Likes from a specific user"
    },
    "users/{userId}/favorites/{videoId}": {
      "schema": {
        "$ref": "#/entities/Favorite"
      },
      "description": "Bookmarked favorite videos for quick access"
    },
    "videoStats/{videoId}": {
      "schema": {
        "$ref": "#/entities/VideoStats"
      },
      "description": "Public video statistics"
    }
  }
}